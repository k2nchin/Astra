{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astra",
  "version": "0.3.0",
  "identifier": "com.cubeai.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "Astra", "width": 88, "height": 88, "visible": false, "fullscreen": false, "transparent": true, "backgroundColor": "#00000000", "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "shadow": false }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": ["nsis"], "resources": ["resources/speech/"], "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"], "createUpdaterArtifacts": false, "useLocalToolsDir": true }
}
